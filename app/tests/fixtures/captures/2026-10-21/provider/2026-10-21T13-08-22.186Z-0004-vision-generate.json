        "text": "{\n  \"confidence\": \"high\",\n  \"equipmentVisible\": \"Smartfon z mocno uszkodzonym, popękanym ekranem.\",\n  \"imageUsable\": \"yes\",\n  \"matchesCategory\": \"yes\",\n  \"matchesModel\": \"uncertain\",\n  \"observations\": [\n    {\n      \"component\": \"Ekran\",\n      \"description\": \"Widoczne liczne pęknięcia; duża część wyświetlacza jest ciemna, a przez ekran przebiega zielona linia.\",\n      \"location\": \"Przednia powierzchnia urządzenia\"\n    },\n    {\n      \"component\": \"Obudowa\",\n      \"description\": \"Widoczne krawędzie obudowy; na zdjęciu nie widać jednoznacznych odkształceń.\",\n      \"location\": \"Wzdłuż boków urządzenia\"\n    }\n  ],\n  \"safetyHazards\": [],\n  \"unusableReason\": null,\n  \"damages\": [\n    {\n      \"extent\": \"Rozległe, liczne pęknięcia obejmujące znaczną część ekranu.\",\n      \"location\": \"Ekran, przede wszystkim górna część i okolice górnej lewej krawędzi, z pęknięcię\"\n      ,\n      \"type\": \"crack\"\n    },\n    {\n      \"extent\": \"Duży ciemny obszar oraz widoczna zielona linia na wyświetlaczu.\",\n      \"location\": \"Ekran, po lewej stronie i przez środkową część wyświetlacza\",\n      \"type\": \"dead_pixels_or_lines\"\n    }\n  ],\n  \"damageVisible\": \"yes\",\n  \"externalCauseTraces\": [\n    \"radiating_cracks\"\n  ],\n  \"likelyCause\": \"user_caused\",\n  \"likelyCauseRationale\": \"Rozległe pęknięcia promieniście rozchodzące się w górnej części ekranu oraz zaburzenia obrazu są widoczne na zdjęciu i mogą wskazywać na uszkodzenie mechaniczne. Samo zdjęcie nie pozwala ustalić dokładnego zdarzenia.\",\n  \"manufacturingDefectTraces\": []\n}"
