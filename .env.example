# Configure the server-side provider and model selected in the course ADR.
# Fill only the selected provider key locally. Never commit real values.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Required: OpenRouter model ID of the decision agent (chat).
LLM_MODEL=
# Optional: OpenRouter model ID for photo analysis; defaults to LLM_MODEL when empty.
VISION_MODEL=
# Optional: set only for capture runs (npm run capture); leave empty otherwise.
AI_CAPTURE_DIR=
# Optional: directory with return-policy.md and complaint-policy.md; default ../docs/policies (relative to app/).
POLICIES_DIR=
# Optional: app port; default 3000.
PORT=
